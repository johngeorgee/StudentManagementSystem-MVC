@model Project.Models.ViewModels.EditDepartment

@{
    ViewData["Title"] = "Edit Departments";
}

<!DOCTYPE html>

<html>
<head>
    <title>Edit Department</title>
</head>
<body>
<div>
    <h2 class="mb-3">Edit Department</h2>

    <form asp-controller="Department" asp-action="SaveEdit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label">Name</label>
            <input id="Name" name="Name" value="@Model?.Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Manager Name</label>
            <input id="ManagerName" name="ManagerName" value="@Model?.ManagerName" class="form-control" />
        </div>
        


        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/Department/Index" class="btn btn-secondary">Cancel</a>

    </form>
</div>
</body>
</html>