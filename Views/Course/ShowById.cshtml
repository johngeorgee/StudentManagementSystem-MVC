@model Project.Models.Course

@{
    ViewData["Title"] = "Course Details";
}

<!-- Header Card -->
<div class="card stat-card mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h6 class="mb-0 fw-semibold">
            <i class="bi bi-journal-bookmark me-2"></i>Course Details
        </h6>
        <div>
            <a href="/Course/Edit/@Model.Id" class="btn btn-warning btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a href="/Course/Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">ID</dt>
                    <dd class="col-sm-8">@Model.Id</dd>

                    <dt class="col-sm-4 text-muted">Name</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

                    <dt class="col-sm-4 text-muted">Department</dt>
                    <dd class="col-sm-8">
                        <a href="/Department/Details/@Model.DepartmentId" class="text-decoration-none">
                            @Model.Department?.Name
                        </a>
                    </dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Max Degree</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-primary-subtle text-primary fs-6">@Model.Degree</span>
                    </dd>

                    <dt class="col-sm-4 text-muted">Min Degree</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-warning-subtle text-warning fs-6">@Model.MinDegree</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- Instructors -->
<div class="card stat-card mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold">
            <i class="bi bi-person-badge me-2"></i>Instructors
            <span class="badge bg-secondary ms-2">@(Model.Instructors?.Count ?? 0)</span>
        </h6>
    </div>
    <div class="card-body p-0">
        @if (Model.Instructors != null && Model.Instructors.Any())
        {
            <table class="table mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Salary</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Instructors)
                    {
                        <tr>
                            <td>@i.Name</td>
                            <td>@i.Email</td>
                            <td>@i.Phone</td>
                            <td>@i.Salary.ToString("N0") EGP</td>
                            <td class="text-end">
                                <a href="/Instructor/ShowById/@i.Id" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye">View</i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted p-3 mb-0">No instructors assigned to this course.</p>
        }
    </div>
</div>

<!-- Course Results -->
<div class="card stat-card">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold">
            <i class="bi bi-clipboard-check me-2"></i>Course Results
            <span class="badge bg-secondary ms-2">@(Model.CourseResults?.Count ?? 0)</span>
        </h6>
    </div>
    <div class="card-body p-0">
        @if (Model.CourseResults != null && Model.CourseResults.Any())
        {
            <table class="table  mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Trainee</th>
                        <th>Degree</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.CourseResults)
                    {
                        var passed = r.Degree >= Model.MinDegree;
                        <tr>
                            <td>@(r.Trainee?.Name ?? "N/A")</td>
                            <td>@r.Degree / @Model.Degree</td>
                            <td>
                                @if (passed)
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        <i class="bi bi-check-circle me-1"></i>Passed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger">
                                        <i class="bi bi-x-circle me-1"></i>Failed
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/CourseResult/ShowById/@r.Id" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye">View</i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted p-3 mb-0">No results recorded for this course yet.</p>
        }
    </div>
</div>