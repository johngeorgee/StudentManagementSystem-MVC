@model Project.Models.ViewModels.EditCourse
@{
    ViewData["Title"] = "Edit Course";
}
<!DOCTYPE html>

<html>
<head>
    <title>Edit Course</title>
</head>
<body>
<div>

    <form asp-controller="Course" asp-action="SaveEdit" method="post">
        <input type="hidden" asp-for="Id">
        <div class="mb-3">
            <label class="form-label" asp-for="Name">Name</label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Degree" class="form-label">Degree</label>
            <input asp-for="Degree" type="number" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="DepartmentId">Department</label>
            <select asp-for="DepartmentId"  class="form-select">
               @foreach (var item in Model.Department)
               {
                    <option value="@item.Id" >@item.Name</option>
               }
                    
                
            </select>
        </div>
      
       

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-controller="Course" asp-action="Index" class="btn btn-secondary">Back</a>

    </form>
</div>
</body>
</html>