@model Project.Models.ViewModels.EditInstructor

@{
    ViewData["Title"] = "Edit Instructors";
}

<!DOCTYPE html>

<html>
<head>
    <title>Edit Instructor</title>
</head>
<body>
<div>
    <h2 class="mb-3">Edit Instructor</h2>

    <form asp-controller="Instructor" asp-action="SaveEdit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name</label>
            <input asp-for="Name" value="@Model?.Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Salary" class="form-label">Salary</label>
            <input asp-for="Salary" value="@Model?.Salary" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" value="@Model?.Email" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="DepartmentId">Department</label>
            <select asp-for="DepartmentId"  class="form-select">
                @foreach (var item in Model.Department)
                {
                    <option value="@item.Id" >@item.Name</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="CourseId">Department</label>
            <select asp-for="CourseId"  class="form-select">
                @foreach (var item in Model.Course)
                {
                    <option value="@item.Id" >@item.Name</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/Instructor/Index" class="btn btn-secondary">Cancel</a>

    </form>
</div>
</body>
</html>