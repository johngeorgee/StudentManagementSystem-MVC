@model Instructor

@{
    ViewData["Title"] = "Add Instructor";
}

<!DOCTYPE html>

<html>
<head>
    <title>Add Instructor</title>
</head>
<body>
<div>

    <form asp-action="Add" method="post">

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input id="Name" name="Name" value="@Model?.Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Phone Number</label>
            <input id="Phone" name="Phone" value="@Model?.Phone" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Address</label>
            <input id="Address" name="Address" value="@Model?.Address" type="text"  class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input id="Email" name="Email" value="@Model?.Email" type="email"  class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Salary</label>
            <input id="Salary" name="Salary" value="@Model?.Salary" type="number"  class="form-control" />
        </div>
  
        
        
        <div class="mb-3">
            <label class="form-label">Department</label>
            <select asp-for="DepartmentId" asp-items="ViewBag.Departments"  class="form-select">
        
                <option value="">-- Select Department --</option>
        
        
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Course</label>
            <select asp-for="CourseId" asp-items="ViewBag.Courses"  class="form-select">
        
                <option value="">-- Select Course --</option>
        
        
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/Instructor/Index" class="btn btn-secondary">Cancel</a>

    </form>
</div>
</body>
</html>