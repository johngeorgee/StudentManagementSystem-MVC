@model CourseResult


@{
    ViewData["Title"] = "Add Result";
}
<!DOCTYPE html>

<html>
<head>
    <title>Add Result</title>
</head>
<body>
<div>


    <form asp-action="Add" method="post">

        <div class="mb-3">
            <label class="form-label">Degree</label>
            <input asp-for="Degree" value="@Model?.Degree" class="form-control" />
        </div>

        
        <div class="mb-3">
            <label class="form-label">Course</label>
            <select asp-for="CourseId" asp-items="ViewBag.Courses"  class="form-select">
               
                <option value="">-- Select Course --</option>
  
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Trainee</label>
            <select asp-for="TraineeId" asp-items="ViewBag.Trainees"  class="form-select">
               
                <option value="">-- Select Trainee --</option>
  
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/CourseResult/Index" class="btn btn-secondary">Cancel</a>

    </form>
</div>
</body>
</html>