<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Project</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Project.styles.css" asp-append-version="true"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body>
<aside class="sidebar" id="sidebar">
    <div class="brand">
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <i class="bi bi-mortarboard-fill"></i>
            <span>Student MS</span>
        </a> 
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" 
                aria-expanded="false" aria-label="Toggle navigation"> 
            <span class="navbar-toggler-icon"></span> 
        </button>

    </div>

    <nav class="nav flex-column mt-2  navbar-expand-sm navbar-toggleable-sm  box-shadow mb-3">
        <a class="nav-link"
           asp-controller="Home" asp-action="Index">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>

        <div class="nav-section">Academic</div>

        <a class="nav-link "
           asp-controller="Department" asp-action="Index">
            <i class="bi bi-building"></i> Departments
        </a>

        <a class="nav-link"
           asp-controller="Course" asp-action="Index">
            <i class="bi bi-journal-bookmark"></i> Courses
        </a>

        <a class="nav-link "
           asp-controller="Instructor" asp-action="Index">
            <i class="bi bi-person-badge"></i> Instructors
        </a>

        <div class="nav-section">People & Results</div>

        <a class="nav-link "
           asp-controller="Trainee" asp-action="Index">
            <i class="bi bi-people"></i> Trainees
        </a>

        <a class="nav-link "
           asp-controller="CourseResult" asp-action="Index">
            <i class="bi bi-clipboard-check"></i> Course Results
        </a>
    </nav>
</aside>
<div class="main-wrapper ">

<!-- Topbar -->
<header class="topbar ">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-light sidebar-toggle" id="sidebarToggle">
            <i class="bi bi-list fs-4"></i>
        </button>
        <h5 class="mb-0 fw-semibold">@ViewData["Title"]</h5>
    </div>

    <div class="d-flex align-items-center gap-3 ">
        <button class="btn btn-light position-relative">
            <i class="bi bi-bell"></i>
        </button>
        <div class="dropdown">
            <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2" data-bs-toggle="dropdown">
                <i class="bi bi-person-circle fs-5"></i>
                <span class="d-none d-md-inline">Admin</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Profile</a></li>
                <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Settings</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
            </ul>
        </div>
    </div>
</header>


<div class="container-fluid mt-5 ">
    <main role="main" class="pb-3 mx-3">
        @RenderBody()
    </main>
</div>
</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>