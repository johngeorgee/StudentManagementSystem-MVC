@model Trainee

@{
    ViewData["Title"] = "Add Trainee";
}
<!DOCTYPE html>

<html>
<head>
    <title>Add Trainee</title>
</head>
<body>
<div>


    <form asp-action="Add" method="post">

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input id="Name" name="Name" value="@Model?.Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Phone Number</label>
            <input id="PhoneNumber" name="PhoneNumber" value="@Model?.PhoneNumber" type="tel" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Grade</label>
            <input id="Grade" name="Grade" value="@Model?.Grade" type="number"  class="form-control" />
        </div>
        
        <div class="mb-3">
            <label class="form-label">Department</label>
            <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select">
               
                    <option value=" ">-- Select Department --</option>
                    
                
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/Trainee/Index" class="btn btn-secondary">Cancel</a>

    </form>
</div>
</body>
</html>